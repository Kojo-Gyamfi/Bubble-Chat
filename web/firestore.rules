rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allowed = `allowed` custom claim, or (no claim yet) a verified email
    // listed in allowlist/{email}. A claim of `false` always denies (removed users).
    function isAllowed() {
      let token = request.auth.token;
      return token.get('allowed', null) == true
        || (token.get('allowed', null) != false
            && token.get('email_verified', false) == true
            && exists(/databases/$(database)/documents/allowlist/$(token.email.lower())));
    }

    // Users read their own profile, conversations and messages.
    // All writes go through the server (admin SDK), which bypasses these rules.
    match /users/{uid}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == uid && isAllowed();
      allow write: if false;
    }

    // allowlist/** and usage/** (and everything else): no client access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
