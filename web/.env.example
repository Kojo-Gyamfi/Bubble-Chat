# Copy to .env.local (never commit it). In Vercel, set the same keys in the dashboard.

# Firebase web app config (Project settings → Your apps → Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
# Local dev: <project-id>.firebaseapp.com
# Vercel:    your-app.vercel.app  (served via the /__/auth rewrite; fixes iOS PWA sign-in)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# base64 of the service-account JSON:
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
#   bash:       base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=

LLM_PROVIDER=gemini                   # gemini (whole model chain) | groq (only the Groq models) | mock (canned replies, no key needed)
# Optional: models to try in order, best first (provider:model, optional @reasoning).
# Free limits are per model, so they add up; a model that runs out is skipped until it resets.
# Default: gemini-3.8-flash@low, gemini-3.6-flash, gemini-2.5-flash, gemini-3.5-flash-lite,
#          gemini-3.1-flash-lite, then groq openai/gpt-oss-120b, qwen/qwen3.8-27b, openai/gpt-oss-20b
LLM_CHAIN=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
DAILY_REQUEST_LIMIT=100               # per user
GLOBAL_DAILY_REQUEST_LIMIT=1000       # all users; keep below the model chain's free requests/day (~1,060 on Gemini)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Local development against the Firebase emulators (never set in production):
#   firebase emulators:start --only auth,firestore --project demo-bubble
# NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-bubble
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# (leave FIREBASE_SERVICE_ACCOUNT_BASE64 empty; no credentials needed)
