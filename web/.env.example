# Copy to .env.local (never commit it). In Vercel, set the same keys in the dashboard.

# Firebase web app config (Project settings → Your apps → Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
# Local dev: <project-id>.firebaseapp.com
# Vercel:    your-app.vercel.app  (served via the /__/auth rewrite; fixes iOS PWA sign-in)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# base64 of the service-account JSON:
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
#   bash:       base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=

LLM_PROVIDER=gemini                   # gemini (whole model chain, Claude first) | groq (only the Groq models) | mock (canned replies, no key needed)
# Optional: models to try in order, best first (provider:model, optional @reasoning; provider is claude, gemini or groq).
# A model whose key isn't set is left out; one that fails or runs out is skipped for a while.
# Default: claude:claude-opus-5-5 (paid), then the free gemini-3.5-flash-lite, gemini-2.5-flash,
#          gemini-3.1-flash-lite, groq openai/gpt-oss-120b, gemini-3.6-flash, gemini-3.8-flash@low,
#          groq qwen/qwen3.8-27b, openai/gpt-oss-20b
LLM_CHAIN=
ANTHROPIC_API_KEY=                    # Claude (paid, the default model): console.anthropic.com → API keys
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
DAILY_REQUEST_LIMIT=100               # per user
GLOBAL_DAILY_REQUEST_LIMIT=1000       # all users; also caps Claude spend (~2.4¢/message on Opus 5.5 ≈ $24/day max)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Android OTA update banner (/api/android-version). The app shows "Update available"
# when ANDROID_VERSION_CODE exceeds the installed build. Bump these on each release;
# apkUrl points at the GitHub release asset. Keep in sync with android/app/build.gradle.kts.
ANDROID_VERSION_CODE=5
ANDROID_VERSION_NAME=0.5.0
ANDROID_APK_URL=https://github.com/your-name/your-repo/releases/latest/download/app-release.apk

# Local development against the Firebase emulators (never set in production):
#   firebase emulators:start --only auth,firestore --project demo-bubble
# NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-bubble
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# (leave FIREBASE_SERVICE_ACCOUNT_BASE64 empty; no credentials needed)
