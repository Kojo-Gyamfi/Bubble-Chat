# Copy to .env.local (never commit it). In Vercel, set the same keys in the dashboard.

# Firebase web app config (Project settings → Your apps → Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
# Local dev: <project-id>.firebaseapp.com
# Vercel:    your-app.vercel.app  (served via the /__/auth rewrite; fixes iOS PWA sign-in)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# base64 of the service-account JSON:
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
#   bash:       base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=

LLM_PROVIDER=gemini                   # gemini | groq (gemini auto-falls back to groq on 429)
LLM_MODEL=                            # current free-tier Gemini Flash model ID
GROQ_MODEL=                           # current Groq Llama model ID
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
DAILY_REQUEST_LIMIT=25                # per user
GLOBAL_DAILY_REQUEST_LIMIT=200        # all users; keep below Gemini free-tier RPD
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
