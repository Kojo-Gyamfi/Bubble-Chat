<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@null"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tagline"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Start / stop -->
        <TextView
            android:id="@+id/bubbleStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:text="@string/bubble_stopped" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toggleBubble"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="@string/start_bubble"
            android:textSize="16sp"
            app:cornerRadius="28dp" />

        <!-- Setup -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_setup" />

        <com.google.android.material.card.MaterialCardView style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout style="@style/SetupRow">

                    <LinearLayout style="@style/SetupText">

                        <TextView
                            style="@style/RowTitle"
                            android:text="@string/overlay_title" />

                        <TextView
                            style="@style/RowDesc"
                            android:text="@string/overlay_desc" />

                        <TextView
                            android:id="@+id/overlayStatus"
                            style="@style/RowStatus" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/grantOverlay"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/action_allow" />
                </LinearLayout>

                <View
                    android:id="@+id/notificationsDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="@color/panel_border" />

                <LinearLayout
                    android:id="@+id/notificationsRow"
                    style="@style/SetupRow">

                    <LinearLayout style="@style/SetupText">

                        <TextView
                            style="@style/RowTitle"
                            android:text="@string/notifications_title" />

                        <TextView
                            style="@style/RowDesc"
                            android:text="@string/notifications_desc" />

                        <TextView
                            android:id="@+id/notificationsStatus"
                            style="@style/RowStatus" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/grantNotifications"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/action_allow" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Account -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_account" />

        <com.google.android.material.card.MaterialCardView style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/accountStatus"
                    style="@style/RowStatus"
                    android:layout_width="match_parent"
                    android:layout_marginTop="0dp"
                    android:text="@string/account_not_linked" />

                <TextView
                    android:id="@+id/accountDesc"
                    style="@style/RowDesc"
                    android:layout_marginTop="4dp"
                    android:text="@string/account_desc" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/relink"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/link_account" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openWebApp"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/open_web_app" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Background reliability -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_background" />

        <com.google.android.material.card.MaterialCardView style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/batteryDesc"
                    style="@style/RowDesc"
                    android:layout_marginTop="0dp"
                    android:text="@string/battery_desc" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/battery"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/battery_action" />

                <TextView
                    android:id="@+id/unusedDesc"
                    style="@style/RowDesc"
                    android:layout_marginTop="16dp"
                    android:text="@string/unused_desc" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/unusedApps"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/unused_action" />

                <TextView
                    style="@style/RowDesc"
                    android:layout_marginTop="16dp"
                    android:text="@string/oem_help" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/appSettings"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/open_app_settings" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
