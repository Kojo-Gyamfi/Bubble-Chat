# Copy this file to android/keystore.properties (gitignored) and fill in the blanks.
# NEVER commit the real keystore.properties or the .jks keystore, and BACK THE KEYSTORE UP:
# if you lose it you cannot update the app — users must uninstall and reinstall.
#
# Generate the keystore once (run it yourself; keep the .jks OUTSIDE the repo):
#   keytool -genkeypair -v -keystore C:/keys/bubble-release.jks -alias bubble \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile may be an absolute path (recommended, outside the repo) or a path
# relative to the android/ project root.

storeFile=C:/keys/bubble-release.jks
storePassword=
keyAlias=bubble
keyPassword=
