# Copy the bubble.* lines into android/local.properties (gitignored; Android Studio
# also writes sdk.dir there). No trailing slash.

# Debug builds on a real phone: your ngrok HTTPS URL for `npm run dev`
# (or http://<this PC's LAN IP>:3000 with the phone on the same Wi-Fi).
# The Android emulator default is http://10.0.2.2:3000.
bubble.debugBaseUrl=https://your-subdomain.ngrok-free.dev

# Release builds: the deployed web app.
bubble.releaseBaseUrl=https://your-app.vercel.app
